-- =====================================================================
-- ROM: память команд (64 слова x 9 бит), ША = 6, слово команды = 9 бит
-- Формат команды:  [8] КОП | [7..6] R | [5..0] ADR
--   0 = MOV M -> R (прямая адресация операнда-источника)
--   1 = JZ      $ADR (непосредственная адресация адреса перехода)
--
-- Микропрограмма:
--   00  MOV M[4], R0   R0 <- RAM[4] = 9  (Z=0)
--   01  JZ  $3         Z=0 -> перехода нет, идём на 02
--   02  MOV M[5], R1   R1 <- RAM[5] = 6  (Z=0)
--   03  MOV M[6], R2   R2 <- RAM[6] = F  (Z=0)
--   04  MOV M[7], R3   R3 <- RAM[7] = 0  (Z=1)
--   05  JZ  $0         Z=1 -> переход на 00 (цикл)
--   06..3F  не используются (программа зациклена на 00 и дальше 05 не идёт)
-- =====================================================================
DEPTH = 64;
WIDTH = 9;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
  00 : 004;   -- MOV M[4], R0 : 0 00 000100
  01 : 103;   -- JZ  $3       : 1 00 000011
  02 : 045;   -- MOV M[5], R1 : 0 01 000101
  03 : 086;   -- MOV M[6], R2 : 0 10 000110
  04 : 0C7;   -- MOV M[7], R3 : 0 11 000111
  05 : 100;   -- JZ  $0       : 1 00 000000
  [06..3F] : 000;
END;
