-- =====================================================================
-- ROM: память команд (16 слов x 8 бит), ША = 4, слово команды = 8 бит
-- Формат команды:  [7..6] КОП | [5..2] ADR | [1..0] R
--   01 = MOV M -> R (прямая адресация операнда-источника)
--   10 = JZ  $ADR   (непосредственная адресация адреса перехода)
--   00 = NOP
--
-- Микропрограмма:
--   00  MOV M[4], R0   R0 <- RAM[4] = 0A  (Z=0)
--   01  JZ  $3         Z=0 -> перехода нет, идём на 02
--   02  MOV M[5], R1   R1 <- RAM[5] = 15  (Z=0)
--   03  MOV M[6], R2   R2 <- RAM[6] = 2A  (Z=0)
--   04  MOV M[7], R3   R3 <- RAM[7] = 00  (Z=1)
--   05  JZ  $0         Z=1 -> переход на 00 (цикл)
--   06..0F  NOP
-- =====================================================================
DEPTH = 16;
WIDTH = 8;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
  00 : 50;   -- MOV M[4], R0 : 01 0100 00
  01 : 8C;   -- JZ  $3       : 10 0011 00
  02 : 55;   -- MOV M[5], R1 : 01 0101 01
  03 : 5A;   -- MOV M[6], R2 : 01 0110 10
  04 : 5F;   -- MOV M[7], R3 : 01 0111 11
  05 : 80;   -- JZ  $0       : 10 0000 00
  [06..0F] : 00;   -- NOP
END;
