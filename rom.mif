-- =====================================================================
-- ROM: память команд (64 слова x 10 бит), ША = 6, слово команды = 10 бит
-- Формат команды:  [9..8] КОП | [7..2] ADR | [1..0] R
--   01 = MOV M -> R (прямая адресация операнда-источника)
--   10 = JZ  $ADR   (непосредственная адресация адреса перехода)
--   00 = NOP
--
-- Микропрограмма:
--   00  MOV M[4], R0   R0 <- RAM[4] = 9  (Z=0)
--   01  JZ  $3         Z=0 -> перехода нет, идём на 02
--   02  MOV M[5], R1   R1 <- RAM[5] = 6  (Z=0)
--   03  MOV M[6], R2   R2 <- RAM[6] = F  (Z=0)
--   04  MOV M[7], R3   R3 <- RAM[7] = 0  (Z=1)
--   05  JZ  $0         Z=1 -> переход на 00 (цикл)
--   06..3F  NOP
-- =====================================================================
DEPTH = 64;
WIDTH = 10;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
  00 : 110;   -- MOV M[4], R0 : 01 000100 00
  01 : 20C;   -- JZ  $3       : 10 000011 00
  02 : 115;   -- MOV M[5], R1 : 01 000101 01
  03 : 11A;   -- MOV M[6], R2 : 01 000110 10
  04 : 11F;   -- MOV M[7], R3 : 01 000111 11
  05 : 200;   -- JZ  $0       : 10 000000 00
  [06..3F] : 000;   -- NOP
END;
