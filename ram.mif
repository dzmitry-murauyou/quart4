-- =====================================================================
-- RAM: память данных (16 слов x 6 бит), ША = 4, ШД = 6
-- Данные для микропрограммы из rom.mif
-- =====================================================================
DEPTH = 16;
WIDTH = 6;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
  [00..03] : 00;   -- не используются
  04 : 0A;   -- R0 = 0Ah (10)  -> Z = 0
  05 : 15;   -- R1 = 15h (21)  -> Z = 0
  06 : 2A;   -- R2 = 2Ah (42)  -> Z = 0
  07 : 00;   -- R3 = 00h      -> Z = 1
  [08..0F] : 00;   -- не используются
END;
