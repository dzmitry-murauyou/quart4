-- =====================================================================
-- RAM: память данных (64 слова x 4 бита), ША = 6, ШД = 4
-- Данные для микропрограммы: ячейки 4, 5, 6, 7
-- =====================================================================
DEPTH = 64;
WIDTH = 4;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
  04 : 9;
  05 : 6;
  06 : F;
  07 : 0;
  [00..03] : 0;
  [08..3F] : 0;
END;
